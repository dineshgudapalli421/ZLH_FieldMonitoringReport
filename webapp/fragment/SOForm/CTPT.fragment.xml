<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:smarttable="sap.ui.comp.smarttable"
    height="100%"
>
<smarttable:SmartTable 
    id="ctptSmartTable"
    entitySet="CTPT"
    tableBindingPath="CTPTModel>/CTPT"
    tableType="ResponsiveTable"
    useVariantManagement="true"
    useTablePersonalisation="true"
    header="CTPT Data"
    showRowCount="true"
    enableAutoBinding="true"
    enableExport="false"
    demandPopin="true"
    persistencyKey="SmartTableSoFormCTPT"
    requestAtLeastFields="OrderID,Rev_Num,Row_Num,Eid,Serialnumber,OldSerialnumber_Corectd,Manufserialnumber,Devicecategory,Deviceremoval,Deviceremoval_Corected,Newserialnumber,NewSerialnumber_Corectd,Newmanufserialnumber,Newdevicecategory,newfuncclass,newtxwindenom,Denominator_Corectd,Newtxwindnumber,Numerator_Corectd"
>
<Table
        id="idTableCTPT"
        selectionMode="None"
        rows="{path: 'CTPTModel>/CTPT'}"
        fixedColumnCount="1"
    >
        <columns>
            <!-- <Column
               visible="false"
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Eid" />
                <template>
                    <m:Text text="{CTPTModel>eid}" textAlign="Center"/>
                </template>
            </Column> -->
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>orderNumber}" />
                <template>
                    <m:Text text="{CTPTModel>OrderID}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Rev_Num" />
                <template>
                    <m:Text text="{CTPTModel>Rev_Num}"  textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Row_Num" />
                <template>
                    <m:Text text="{CTPTModel>Row_Num}"  textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Eid" />
                <template>
                    <m:Text text="{CTPTModel>Eid}"  textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="12rem"
                hAlign="End"
            >
                <m:Label text="{i18n>oldEquipmentSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Serialnumber}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="Corrected Old Tx Number" class="statusColumn" tooltip="Old Serial Number Corrected"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>OLDSERIALNUMBER_CORECTD}" /> -->
                    <m:Input id="idOLDSERIALNUMBER_CORECTD" value="{CTPTModel>OldSerialnumber_Corectd}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="12rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>oldManufSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Manufserialnumber}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>deviceCategory}" />
                <template>
                    <m:Text text="{CTPTModel>Devicecategory}"  textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="5rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>deviceRemoval}" />
                <template>
                    <m:Text
                        text="{CTPTModel>Deviceremoval}"
                        wrapping="true"
                     textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="13rem"
                hAlign="Center"
            >
                <m:Label text="Tx Removed corrected"  class="statusColumn"  tooltip="New Serial Number Corrected"/>
                <template>
                <m:Input id="idDeviceremoval_Corected" value="{CTPTModel>Deviceremoval_Corected}" maxLength="20"></m:Input>
                    <!-- <m:Text
                        text="{CTPTModel>Deviceremoval_Corected}"
                        wrapping="true"
                     textAlign="Center"/> -->
                </template>
            </Column>
            <Column
                width="13rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newEquipmentSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Newserialnumber}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="Corrected New Tx Badge Number" class="statusColumn" tooltip="New Serial Number Corrected"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>NEWSERIALNUMBER_CORECTD}"/> -->
                    <m:Input id="idNEWSERIALNUMBER_CORECTD" value="{CTPTModel>NewSerialnumber_Corectd}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newManufSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Newmanufserialnumber}"  textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newDeviceCategory}" />
                <template>
                    <m:Text
                        text="{CTPTModel>Newdevicecategory}"
                        wrapping="true"
                     textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newFuncClass}" />
                <template>
                    <m:Text text="{CTPTModel>newfuncclass}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="6rem"
                hAlign="Center"
            >
                <m:Label text="New Tx Denominator" />
                <template>
                    <m:Text text="{CTPTModel>newtxwindenom}" textAlign="Center"/>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center" 
            >
                <m:Label text="Corrected New Tx Denominator" class="statusColumn" tooltip="Denominator Corrected"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>DENOMINATOR_CORECTD}" /> -->
                    <m:Input id="idDENOMINATOR_CORECTD" value="{CTPTModel>Denominator_Corectd}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="New Tx Numerator" />
                <template>
                    <m:Text text="{CTPTModel>Newtxwindnumber}"  textAlign="Center"/>
                </template>
            </Column>
           <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="Corrected New Tx Numerator" class="statusColumn" tooltip="Numerator Corrected"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>NUMERATOR_CORECTD}" /> -->
                    <m:Input id="idNUMERATOR_CORECTD" value="{CTPTModel>Numerator_Corectd}" maxLength="20"></m:Input>
                </template>
            </Column>
        </columns>
    </Table>
</smarttable:SmartTable>
    
</core:FragmentDefinition>