<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
>
    <Table
        id="idTableCTPT"
        selectionMode="None"
        rows="{path: 'CTPTModel>/CTPT'}"
    >
        <columns>
            <Column
               visible="false"
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Eid" />
                <template>
                    <m:Text text="{CTPTModel>eid}" />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>orderNumber}" />
                <template>
                    <m:Text text="{CTPTModel>OrderID}" />
                </template>
            </Column>
            <Column
                width="12rem"
                hAlign="End"
            >
                <m:Label text="{i18n>oldEquipmentSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Serialnumber}" />
                </template>
            </Column>
            <Column
                width="12rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>oldManufSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Manufserialnumber}" />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>deviceCategory}" />
                <template>
                    <m:Text text="{CTPTModel>Devicecategory}" />
                </template>
            </Column>
            <Column
                width="5rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>deviceRemoval}" />
                <template>
                    <m:Text
                        text="{CTPTModel>Deviceremoval}"
                        wrapping="true"
                    />
                </template>
            </Column>
            <Column
                width="13rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newEquipmentSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Newserialnumber}" />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newManufSerialNum}" />
                <template>
                    <m:Text text="{CTPTModel>Newmanufserialnumber}" />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newDeviceCategory}" />
                <template>
                    <m:Text
                        text="{CTPTModel>Newdevicecategory}"
                        wrapping="true"
                    />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newFuncClass}" />
                <template>
                    <m:Text text="{CTPTModel>newfuncclass}" />
                </template>
            </Column>
            <Column
                width="6rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newTxWinDenom}" />
                <template>
                    <m:Text text="{CTPTModel>newtxwindenom}" />
                </template>
            </Column>
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="{i18n>newTxWinNumber}" />
                <template>
                    <m:Text text="{CTPTModel>Newtxwindnumber}" />
                </template>
            </Column>
            <!-- added columns @25-06-2025 -->
            <Column
                width="9rem"
                hAlign="Center"
            >
                <m:Label text="Rev_Num" />
                <template>
                    <m:Text text="{CTPTModel>Rev_Num}" />
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="NEWSERIALNUMBER_CORECTD" class="statusColumn"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>NEWSERIALNUMBER_CORECTD}"/> -->
                    <m:Input id="idNEWSERIALNUMBER_CORECTD" value="{CTPTModel>NEWSERIALNUMBER_CORECTD}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="OLDSERIALNUMBER_CORECTD" class="statusColumn" />
                <template>
                    <!-- <m:Text text="{CTPTModel>OLDSERIALNUMBER_CORECTD}" /> -->
                    <m:Input id="idOLDSERIALNUMBER_CORECTD" value="{CTPTModel>OLDSERIALNUMBER_CORECTD}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center" 
            >
                <m:Label text="DENOMINATOR_CORECTD" class="statusColumn"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>DENOMINATOR_CORECTD}" /> -->
                    <m:Input id="idDENOMINATOR_CORECTD" value="{CTPTModel>DENOMINATOR_CORECTD}" maxLength="20"></m:Input>
                </template>
            </Column>
            <Column
                width="15rem"
                hAlign="Center"
            >
                <m:Label text="NUMERATOR_CORECTD" class="statusColumn"/>
                <template>
                    <!-- <m:Text text="{CTPTModel>NUMERATOR_CORECTD}" /> -->
                    <m:Input id="idNUMERATOR_CORECTD" value="{CTPTModel>NUMERATOR_CORECTD}" maxLength="20"></m:Input>
                </template>
            </Column>
        </columns>
    </Table>
</core:FragmentDefinition>