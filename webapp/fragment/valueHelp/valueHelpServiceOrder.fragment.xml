<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<TableSelectDialog
		noDataText="No Orders Found"
		title="Select Orders"
		search=".handleSearch"
		searchPlaceholder="Search Orders"
		confirm=".handleValueHelpClose"
		cancel=".handleValueHelpClose"
		showClearButton="true"
		items="{
			path : '/ORDER_NumberSet',
			sorter : {
				path : 'ORDER_ID',
				descending : false
			}
		}">
		<ColumnListItem selected="{selected}">
			<cells>
				<Text text="{ORDER_ID}" />
				<Text text="{DESCRIPTION}" />
				
			</cells>
		</ColumnListItem>
		<columns>
			<Column width="12em">
				<header>
					<Text text="Order ID" />
				</header>
			</Column>			
			<Column hAlign="End">
				<header>
					<Text text="Description" />
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>