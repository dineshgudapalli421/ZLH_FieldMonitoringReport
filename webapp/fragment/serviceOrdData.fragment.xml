<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
>
    <f:SimpleForm
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="3"
        labelSpanL="3"
        labelSpanM="3"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="4"
        emptySpanL="4"
        emptySpanM="4"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        title="Service Order Data"
        singleContainerFullSize="false"
    >
        <f:content>
            <Label text="Service Order" />
            <MultiInput
                id="idServiceOrder"
                width="60%"
                showValueHelp="false"
                tokenUpdate=".onOrderNoTokenUpdate"
                submit="onSubmitOrderNumber"
                valueHelpRequest=".onValueHelp"
                maxTokens="1600"
                suggestionItemSelected=".onOrderSuggestionItemPress" 
                suggestionRows="{
				path: 'OEBmainService>/Service_OrderSet'
			}"
            >
                <suggestionColumns>
                    <Column>
                        <Label text="Order ID" />
                    </Column>
                    <Column>
                        <Label text="Order Type" />
                    </Column>
                    <Column>
                        <Label text="Description" />
                    </Column>
                </suggestionColumns>
                <suggestionRows>
                    <ColumnListItem>
                        <cells>
                            <Label text="{OEBmainService>OrderId}" />
                            <Label text="{OEBmainService>OrderType}" />
                            <Label text="{OEBmainService>Description}" />
                        </cells>                        
                    </ColumnListItem>
                </suggestionRows>                
            </MultiInput>


            <Label text="Order Type" />
            <MultiInput
                id="idOrderType"
                width="60%"
                showValueHelp="false"
                valueHelpRequest=".onValueHelpRequested"
                suggestionItemSelected=".onOrderTypeSuggestionItemPress"
                tokenUpdate=".onOrderTypeTokenUpdate"
                suggestionRows="{
				path: 'OEBmainService>/Order_TYpeSet'
			}"
            >
                <suggestionColumns>
                    <Column>
                        <Label text="Order Type" />
                    </Column>
                    <Column>
                        <Label text="Description" />
                    </Column>
                </suggestionColumns>
                <suggestionRows>
                    <ColumnListItem>
                        <Label text="{OEBmainService>OrderType}" />
                        <Label text="{OEBmainService>Description}" />
                    </ColumnListItem>
                </suggestionRows>                
            </MultiInput>

             <Label text="Meter Action" />
            <MultiComboBox
                id="idMeterAction"
                selectionChange="handleSelectionChange"
                selectionFinish="handleSelectionFinish"
                selectedKeys="{FieldMonSelModel>/MeterActionSelected}"
                showSelectAll="true"
                width="350px"
                items="{
				path: 'FieldMonSelModel>/MeterAction',
				sorter: { path: 'Name' }
			          }"
            >
                <core:Item
                    key="{FieldMonSelModel>Key}"
                    text="{FieldMonSelModel>description}"
                />
            </MultiComboBox>
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
