            <!-- <MultiInput
                id="idServiceOrder"
                width="60%"
                showValueHelp="true"
			    valueHelpRequest="handleValueHelp"
            >              
            </MultiInput> -->
    <MultiInput
			id="idServiceOrder"
			width="60%"
			valueHelpRequest=".onServiceOrderVH"
            showSuggestion="true"
            suggest=".onSuggestServiceOrder"
            suggestionItemSelected=".onOrderSuggestionItemPress"
			suggestionItems="{suggestionModel>/FilteredItems}">
			<suggestionItems>
				<core:ListItem
					key="{suggestionModel>ORDER_ID}"
					text="{suggestionModel>ORDER_ID}"
					additionalText="{suggestionModel>DESCRIPTION}"/>
			</suggestionItems>
		</MultiInput>

            <Label text="Order Type" />
            <MultiInput
			id="idOrderType"
			width="60%"
			valueHelpRequest=".onOrderTypeVH"
            showSuggestion="true"
            suggestionItemSelected=".onOrderTypeSuggestionItemPress"
			suggestionItems="{
				path: 'OrderTypeModel>/OrderTypeCollection'
			}">
			<suggestionItems>
				<core:ListItem
					key="{OrderTypeModel>OrderType}"
					text="{
						path : 'OrderTypeModel>OrderType'
                    }"
					additionalText="{
						path : 'OrderTypeModel>OrderDesc'
					}"/>
			</suggestionItems>
		</MultiInput>
            <!-- <MultiInput
                id="idOrderType"
                width="60%"
                showValueHelp="false"
