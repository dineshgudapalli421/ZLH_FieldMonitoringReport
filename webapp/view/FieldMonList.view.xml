<mvc:View
    controllerName="com.sap.lh.cs.zlhfieldmonitoring.controller.FieldMonList"
    displayBlock="true"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:vm="sap.ui.fl.variants"
    xmlns:columnmenu="sap.m.table.columnmenu"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <m:Page
        busyIndicatorDelay="1"
        showHeader="false"
    >
        <m:subHeader>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                 <m:Button
                    icon="sap-icon://synchronize"
                    tooltip="Refresh"
                    press="onRefreshSoResults"
                />
                <m:Button
                    icon="sap-icon://list"
                    text="{i18n>label.soResults}"
                    press="onPressSoResults"
                />
                <m:Button
                    icon="sap-icon://pdf-reader"
                    press="onPressSoForms"
                />
                <m:Button
                    text="BPEM"
                    press="onPressBPEM"
                />
            </m:OverflowToolbar>
        </m:subHeader>
        <m:content>
            <Table
                id="idFieldMonTable"
                rows="{FieldMonitorModel>/aFieldMonList}"
                ariaLabelledBy="title"
                selectionMode="Single"
                enableColumnReordering="true"
                width="auto"
            >
                <extension>
                    <m:OverflowToolbar style="Clear">
                        <m:Title
                            id="title"
                            text="Products"
                        />
                        <m:ToolbarSeparator/>
                         <!-- <vm:VariantManagement id="p13nVm" for="persoTable"/> -->
                        <m:ToolbarSpacer />
                        <m:Button
                            editable="{= ${FieldMonitorModel>/aFieldMonList}.length}"
                            icon="sap-icon://sort"
                            tooltip="Sort"
                            press="handleSortButtonPressed"
                        />
                        <m:Button icon="sap-icon://action-settings"
                            tooltip="Settings"
                            press="handleSettingsButtonPressed"/>
                        <!-- <m:Button
                            editable="{= ${FieldMonitorModel>/aFieldMonList}.length}"
                            icon="sap-icon://filter"
                            tooltip="filter"
                            press="handleFilterButtonPressed"
                        /> -->
                    </m:OverflowToolbar>
                </extension>
                <dependents>
                    <columnmenu:Menu id="menu" 
                    showTableSettingsButton="true" 
                    tableSettingsPressed="handleSettingsButtonPressed">
                    </columnmenu:Menu>
                </dependents>
                <columns>
                    <Column app:p13nKey="Status_col" 
                    sortProperty="{i18n>label.status}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="7rem">
                        <m:Label text="{i18n>label.status}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>Status}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="Text_col" 
                    sortProperty="{i18n>label.text}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem">
                        <m:Label text="{i18n>label.text}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>TEXT}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="Log_col" 
                    sortProperty="{i18n>label.log}" headerMenu="menu" resizable="true" 
                    autoResizable="true" 
                        width="6rem"
                        hAlign="End"
                    >
                        <m:Label text="{i18n>label.log}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>Notification}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="ActivityType_col" 
                    sortProperty="{i18n>label.activityType}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="5rem">
                        <m:Label text="{i18n>label.activityType}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>ACTIVITY_TYPE}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="Order_col" 
                    sortProperty="{i18n>label.order}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="14rem">
                        <m:Label text="{i18n>label.order}" />
                        <template>
                            <m:Link
				text="{FieldMonitorModel>ORDER_NO}"
				subtle="true"
				press="handleLinkPress" />
                            <!-- <m:Label text="{FieldMonitorModel>ORDER_NO}"/> -->
                        </template>
                    </Column>
                    <Column app:p13nKey="Opcode_col" 
                    sortProperty="{i18n>label.opCode}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem">
                        <m:Label text="{i18n>label.opCode}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OpCode}" />
                        </template>
                    </Column>
                     <Column app:p13nKey="opDescription_col" 
                    sortProperty="{i18n>label.opDescription}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem">
                        <m:Label text="{i18n>label.opDescription}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OpDescription}" />
                        </template>
                    </Column>                    
                    <Column app:p13nKey="esa_col" 
                    sortProperty="{i18n>label.esa}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="5rem">
                        <m:Label text="{i18n>label.esa}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>ESA}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="billable_col" 
                    sortProperty="{i18n>label.billable}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="7rem">
                        <m:Label text="{i18n>label.billable}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>BILLABLE}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="opsNo_col" 
                    sortProperty="{i18n>label.opsNo}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="14rem">
                        <m:Label text="{i18n>label.opsNo}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OPS_NO}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="opsDesc_col" 
                    sortProperty="{i18n>label.opsDesc}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="14rem">
                        <m:Label text="{i18n>label.opsDesc}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OPS_DESC}" />
                        </template>
                    </Column>                    
                    <Column app:p13nKey="anlage_col" 
                    sortProperty="{i18n>label.anlage}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem">
                        <m:Label text="{i18n>label.anlage}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>Anlage}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="billingClass_col" 
                    sortProperty="{i18n>label.billingClass}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="12rem">
                        <m:Label text="{i18n>label.billingClass}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>BILLING_CLASS}" />
                        </template>
                    </Column>                    
                     <Column
                        app:p13nKey="functionalLocation_col" 
                    sortProperty="{i18n>label.functionalLocation}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.functionalLocation}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>Functional_Loc}" />
                        </template>
                    </Column>
                    <Column app:p13nKey="fieldCompletionDt_col" 
                    sortProperty="{i18n>label.fieldCompletionDt}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="12rem">
                        <m:Label text="{i18n>label.fieldCompletionDt}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>FIELD_COMP_DT}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="address_col" 
                    sortProperty="{i18n>label.address}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="18rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.address}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>ADDRESS}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="keyNo_col" 
                    sortProperty="{i18n>label.keyNo}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="8rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.keyNo}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>KEY_NO}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="meterNo_col" 
                    sortProperty="{i18n>label.meterNo}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.meterNo}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>METER_NO}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="ctpt_col" 
                    sortProperty="{i18n>label.ctpt}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.ctpt}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>CTPT}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="orderType_col" 
                    sortProperty="{i18n>label.orderType}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.orderType}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OT}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="activity_col" 
                    sortProperty="{i18n>label.activity}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.activity}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>ACTIVITY_DESC}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="workCenterId_col" 
                    sortProperty="{i18n>label.workCenterId}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.workCenterId}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>WRKCNTR_ID}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="wrkCntrDesc_col" 
                    sortProperty="{i18n>label.wrkCntrDesc}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.wrkCntrDesc}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>WRKCNTR_DESC}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="descrepancy_col" 
                    sortProperty="{i18n>label.descrepancy}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.descrepancy}" />
                        <template>
                            <m:CheckBox selected="{FieldMonitorModel>Descrepancy}"/>
                        </template>
                    </Column>
                    <Column
                       app:p13nKey="mainActivity_col" 
                    sortProperty="{i18n>label.mainActivity}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.mainActivity}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>MAIN_ACTIVITY}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="inLogStatus_col" 
                    sortProperty="{i18n>label.inLogStatus}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.inLogStatus}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>InLog}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="outLogException_col" 
                    sortProperty="{i18n>label.outLogException}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.outLogException}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OutLog}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="newMeterLocation_col" 
                    sortProperty="{i18n>label.newMeterLocation}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.newMeterLocation}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>NEW_METER_LOC}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="review_col" 
                    sortProperty="{i18n>label.review}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.review}" />
                        <template>
                            <m:CheckBox
                                selected="{
								path: 'FieldMonitorModel>REVIEW'
							}"
                                editable="{FieldMonitorModel>REVIEW_EDITABLE}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="by_col" 
                    sortProperty="{i18n>label.by}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.by}" />
                        <template>
                            <m:Label
                                text="{= !${FieldMonitorModel>REVIEW} ? '' : ${FieldMonitorModel>BY_USER}}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="on_col" 
                    sortProperty="{i18n>label.on}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.on}" />
                        <template>
                            <m:Label
                                id="labelId"
                                text="{= !${FieldMonitorModel>REVIEW} ? '' : ${path:'FieldMonitorModel>ON_SYSTEM', type:'sap.ui.model.odata.type.Date'}}"
                            />
                        </template>
                    </Column>
                    <Column
                       app:p13nKey="at_col" 
                    sortProperty="{i18n>label.at}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.at}" />
                        <template>
                            <m:Label
                                text="{= !${FieldMonitorModel>REVIEW} ? '' : ${path:'FieldMonitorModel>ON_TIME', type:'sap.ui.model.odata.type.Time'}}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="basicStartDt_col" 
                    sortProperty="{i18n>label.basicStartDt}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.basicStartDt}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>BASIC_START_DT_FROM', type: 'sap.ca.ui.model.type.Date'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="finishDt_col" 
                    sortProperty="{i18n>label.finishDt}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.finishDt}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>FINISH_DT_FROM', type: 'sap.ui.model.type.Date'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="mobileCompletionDt_col" 
                    sortProperty="{i18n>label.mobileCompletionDt}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.mobileCompletionDt}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>MOBILE_COMPLETION_DT',type:'sap.ui.model.odata.type.Date'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="mobileCompletionTm_col" 
                    sortProperty="{i18n>label.mobileCompletionTm}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.mobileCompletionTm}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>MOBILE_COMPLETION_TIME',type:'sap.ui.model.odata.type.Time'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="createdBy_col" 
                    sortProperty="{i18n>label.createdBy}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.createdBy}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>CREATED_BY}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="createdOn_col" 
                    sortProperty="{i18n>label.createdOn}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.createdOn}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>CREATED_ON_FROM', type: 'sap.ca.ui.model.type.Date'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="completedBy_col" 
                    sortProperty="{i18n>label.completedBy}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.completedBy}" />
                        <template>
                            <m:Label
                                text="{path:'FieldMonitorModel>COMPLETED_BY'}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="plantSection_col" 
                    sortProperty="{i18n>label.plantSection}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.plantSection}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>PLANT_SECTION}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="fieldsNotes_col" 
                    sortProperty="{i18n>label.fieldsNotes}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.fieldsNotes}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>FIELDS_NOTES}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="activityPerformed_col" 
                    sortProperty="{i18n>label.activityPerformed}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.activityPerformed}" />
                        <template>
                            <m:Label
                                text="{FieldMonitorModel>ACTIVITY_PERFORMED}"
                            />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="workArea_col" 
                    sortProperty="{i18n>label.workArea}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.workArea}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>WORK_AREA}" />
                        </template>
                    </Column>
                    <Column
                        app:p13nKey="opStatus_col" 
                    sortProperty="{i18n>label.opStatus}" headerMenu="menu" resizable="true" 
                    autoResizable="true" width="11rem"
                        hAlign="Center"
                    >
                        <m:Label text="{i18n>label.opStatus}" />
                        <template>
                            <m:Label text="{FieldMonitorModel>OP_STATUS}" />
                        </template>
                    </Column>
                </columns>
            </Table>
        </m:content>
        <m:footer>
            <m:Toolbar>
                <m:ToolbarSpacer />
                <m:Button
                    text="Submit"
                    press="onSubmitFieldMonList"
                />
            </m:Toolbar>
        </m:footer>
    </m:Page>
</mvc:View>
