							selectedKey="Standard"
							defaultKey="Standard"
							showFooter="true"                            
							popoverTitle="my Favorites">
                            <items>
								<VariantItem key="Standard" title="Standard"
									author="B"
									favorite="true"
									visible="true"
									executeOnSelect="false"
									rename="false"
									changeable="false"
									remove="false"
									sharing="Public" />								
							</items>
                </VariantManagement>   -->
                <vm:VariantManagement id="idVariantManagement" for="persoTable"
