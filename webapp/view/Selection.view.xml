                type="XML"
            />
            <core:Fragment
                fragmentName="com.sap.lh.cs.zlhfieldmonitoring.fragment.orderOperationStatus"
                type="XML"
            />
            <core:Fragment
                fragmentName="com.sap.lh.cs.zlhfieldmonitoring.fragment.operationStatus"
                type="XML"
            />
        </content>
        <footer>
            <Toolbar>
