<mvc:View
    controllerName="com.sap.lh.cs.zlhfieldmonitoring.controller.SoForm"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
>
<!-- <l:VerticalLayout width="100%" >
<HBox> -->
<Page
		title="So Form Details"
		class="sapUiContentPadding" >
        <content>
    <IconTabBar
        id="idIconTabBarMeterDetails"
        expanded="{device>/isNoPhone}"
        class="sapUiResponsiveContentPadding"
    >
        <items>
            <IconTabFilter
                text="{i18n>meterDetailsText}"
                key="info"
            >
                <core:Fragment
                    fragmentName="com.sap.lh.cs.zlhfieldmonitoring.fragment.SOForm.meterDetails"
                    type="XML"
                />
            </IconTabFilter>
            <IconTabFilter
                text="{i18n>ctptText}"
                key="attachments"
            >
                <core:Fragment
                    fragmentName="com.sap.lh.cs.zlhfieldmonitoring.fragment.SOForm.CTPT"
                    type="XML"
                />
            </IconTabFilter>
        </items>        
    </IconTabBar>
    </content>
    <footer>
			<Toolbar>
				<ToolbarSpacer/>
				<Button type="Emphasized" text="Save" press="onSave" />
			</Toolbar>
		</footer>
    </Page>
</mvc:View>
